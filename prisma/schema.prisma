generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Alert {
  id             Int      @id @default(autoincrement())
  timestamp      DateTime @default(now())
  source_ip      String
  detector_name  String
  severity       String
  matched_payload String
  request_path   String
  reason         String
}
